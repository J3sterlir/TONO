# Public Supabase client configuration (safe to expose in the browser).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-publishable-key

# Server-only credentials for booking completion and admin endpoints.
# Never put this value in SUPABASE_KEY or any NUXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=your-secret-key
# Legacy alternative: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
